{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": ".test-build",
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "test/**/*.ts",
    "src/lib/p2p/compactSdp.ts",
    "src/lib/p2p/errors.ts",
    "src/types/protocol.ts"
  ]
}
